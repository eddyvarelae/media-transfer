{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "sst.config.ts",
    "infra",
    "src",
    "scripts",
    ".sst/platform/config.d.ts",
    "sst-env.d.ts"
  ]
}
