{
  "name": "media-transfer",
  "version": "2.0.0",
  "description": "Visual SD card offload tool for Sony cameras to SanDisk SSD tars",
  "main": "dist-electron/main.js",
  "author": "Digital Porters",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --target=node20 --external:electron --outdir=dist-electron --format=cjs",
    "start": "npm run build:main && electron .",
    "dev:electron": "npm run build:main && electron .",
    "package": "npm run build:renderer && npm run build:main && electron-builder --mac"
  },
  "build": {
    "appId": "com.digitalporters.mediatransfer",
    "productName": "Media Transfer",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "build/icon.png", "package.json"],
    "mac": {
      "category": "public.app-category.photography",
      "target": "dmg",
      "icon": "build/icon.icns"
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^29.0.0",
    "electron-builder": "^24.12.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
